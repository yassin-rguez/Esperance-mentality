<!DOCTYPE html>
<html lang="ar">
<head>
  <meta charset="UTF-8">
  <title>Esperance Mentality</title>

  <style>
    body {
      margin: 0;
      background-color: #121212;
      font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
      direction: rtl;
    }

    .virage-wrapper { display: flex; min-height: 100vh; position: relative; }

    .side-banner {
      width: 40px;
      background: #000;
      color: #fbc02d;
      border-left: 3px solid #d32f2f;
      writing-mode: vertical-rl;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: bold;
      font-size: 14px;
    }

    .mentality-text { animation: scrollFix 10s linear infinite; white-space: nowrap; }
    @keyframes scrollFix { 0% { transform: translateY(100%); } 100% { transform: translateY(-100%); } }

    .container { flex: 1; padding: 20px 10px; }

    .main-header { text-align: center; margin-bottom: 30px; }
    .channel-logo { width: 90px; height: 90px; border-radius: 50%; border: 2px solid #fbc02d; box-shadow: 0 0 15px #d32f2f; }
    
    h1 { font-size: 24px; margin: 10px 0 5px; color: #fff; }
    .ultras-text { color: #d32f2f; }
    .subtitle { color: #ccc; font-size: 14px; }

    .products { display: flex; flex-direction: column; gap: 20px; }

    .ultras-card {
      background: #1a1a1a;
      border: 1px solid #333;
      padding: 15px;
      border-radius: 8px;
      text-align: center;
      position: relative;
    }

    .pack-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 15px; }
    .pack-grid img { width: 100%; aspect-ratio: 1/1; object-fit: cover; border-radius: 5px; }

    .single-img { width: 80%; border-radius: 8px; margin-bottom: 10px; }

    .stamp {
      position: absolute;
      top: 10px;
      left: -5px;
      background: #d32f2f;
      color: #fff;
      padding: 4px 10px;
      transform: rotate(-15deg);
      font-size: 12px;
      font-weight: bold;
    }

    h3 { color: #fbc02d; }

    .price { color: #fff; }

    .buy-btn {
      background: linear-gradient(45deg, #d32f2f, #900);
      color: #fff;
      border: none;
      padding: 12px;
      width: 100%;
      border-radius: 5px;
      cursor: pointer;
    }

    .audio-controls { text-align: center; margin-top: 20px; }

    .music-btn {
      background: #000;
      color: #fbc02d;
      border: 1px solid #d32f2f;
      padding: 8px 20px;
      border-radius: 20px;
    }
  </style>
</head>

<body>

<audio id="ultras-bg-music" loop>
  <source src="https://dl.dropboxusercontent.com/scl/fi/vjq8frm1ha1s2we3yz7wf/_-Album-La-Guerra-Contra-EL-Olvido-MP3_160K.mp3?dl=1" type="audio/mpeg">
</audio>

<div class="virage-wrapper">

  <aside class="side-banner">
    <div class="mentality-text">MENTALITY • MENTALITY • MENTALITY</div>
  </aside>

  <div class="container">

    <header class="main-header">
      <img src="https://dl.dropboxusercontent.com/scl/fi/qyouai0b4vw6h3s51thnr/Picsart.png?dl=1" class="channel-logo">
      <h1>ESPERANCE <span class="ultras-text">MENTALITY</span></h1>
      <p class="subtitle">المتجر الرسمي لملصقات المكشخة</p>
    </header>

    <section class="products">

      <div class="ultras-card">
        <h3>Pack Taraji</h3>
        <p class="price">15 DT</p>
        <button class="buy-btn">اطلب عبر واتساب</button>
      </div>

    </section>

    <div class="audio-controls">
      <button id="music-toggle" class="music-btn">🔈 تشغيل الأجواء</button>
    </div>

  </div>
</div>

<script>
const audio = document.getElementById('ultras-bg-music');
const btn = document.getElementById('music-toggle');

document.addEventListener('click', () => {
  if(audio.paused){
    audio.play();
    btn.innerText = "🔊 الأجواء مشعلة";
  }
}, {once:true});

btn.addEventListener('click', () => {
  if(audio.paused){
    audio.play();
    btn.innerText = "🔊 الأجواء مشعلة";
  } else {
    audio.pause();
    btn.innerText = "🔈 تشغيل الأجواء";
  }
});
</script>

</body>
</html>
